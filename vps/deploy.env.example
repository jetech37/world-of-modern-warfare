# Deployment settings for your own World of Modern Warfare server.
#
# Copy this file to vps/deploy.env.local (gitignored) and fill in your values. Everything that
# talks to the server reads it: the admin .bat files (admin/), admin/pull-backups.ps1,
# package/publish.py and vps/ship-server.sh. An environment variable of the same name wins over
# the file.
#
# Format: one NAME=value per line, no quotes, no spaces around "=". Lines starting with # are
# comments. A value may start with ~/ for your home folder (%USERPROFILE% on Windows).

# The ssh login of the server (a VPS with Ubuntu 24.04; see vps/setup-server.sh).
AW_VPS=root@203.0.113.10

# The private key that logs in to it.
AW_VPS_KEY=~/.ssh/womw_server

# Optional: the same key as WSL sees it, for vps/ship-server.sh (run as root in WSL). Without
# it the script asks Windows for %USERPROFILE% and uses AW_VPS_KEY under it.
#AW_WSL_VPS_KEY=/mnt/c/Users/you/.ssh/womw_server

# The public HTTPS name of the server: the gate (sign-up, downloads, status) and Caddy answer
# here, and the launcher is built for https://<AW_PUBLIC_HOST>.
AW_PUBLIC_HOST=play.example.net

# Other names Caddy should also answer to (old names that old launchers were built for),
# comma-separated, no spaces. Leave empty for none.
AW_EXTRA_SITES=

# The realm address the game client logs in to (usually the same as AW_PUBLIC_HOST).
AW_GAME_HOST=play.example.net

# Where admin/pull-backups.ps1 copies the server's nightly database backups.
AW_BACKUP_DEST=~/womw-backups

# Optional, for the launcher: a folder where an older client build kept players' settings,
# copied into the install once so nobody loses their keybinds. Leave unset for none.
#AW_OLD_SETTINGS_DIR=
